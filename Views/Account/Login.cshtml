@model _NET_PROJECT.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Account Sign In";
}

<div class="py-5 bg-main">
    <div class="container" style="max-width: 480px;">
        <div class="text-center mb-4">
            <div class="brand-icon mx-auto mb-3" style="width: 48px; height: 48px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <span class="section-badge">Secure Portal</span>
            <h1 class="h3 fw-bold text-white mb-2">Sign In to JobGuard AI</h1>
            <p class="text-secondary-custom small">Enter your credentials to access protected fraud detection tools.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success bg-dark border-success text-success mb-4 d-flex align-items-center gap-2" role="alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        <div class="cyber-card">
            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-dark border-danger text-danger mb-3 py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label-custom">
                        Email Address <span class="text-gold">*</span>
                    </label>
                    <input asp-for="Email" class="form-control form-control-custom" placeholder="name@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger-custom"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label-custom">
                        Password <span class="text-gold">*</span>
                    </label>
                    <input asp-for="Password" class="form-control form-control-custom" placeholder="Enter password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger-custom"></span>
                </div>

                <div class="mb-4 d-flex justify-content-between align-items-center">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input bg-dark border-secondary" />
                        <label asp-for="RememberMe" class="form-check-label text-secondary-custom small">
                            Remember Me
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn-gold w-100 py-2 fw-bold mb-3">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="me-1">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    Sign In
                </button>

                <div class="text-center pt-3 border-top border-dark-custom">
                    <span class="text-secondary-custom small">Don't have an account?</span>
                    <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-gold fw-semibold small ms-1">
                        Create One Now &rarr;
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


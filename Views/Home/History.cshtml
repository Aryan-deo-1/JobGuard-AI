@model IEnumerable<_NET_PROJECT.Models.JobAnalysis>
@{
    ViewData["Title"] = "Analysis History & Records";
}

<div class="py-5 bg-main">
    <div class="container" style="max-width: 1100px;">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
            <div>
                <span class="section-badge mb-1">Database Registry</span>
                <h1 class="h2 fw-bold text-white mb-0">Job Analysis History</h1>
                <p class="text-secondary-custom small mb-0">Persisted job advertisement evaluations and ML.NET threat scores stored in SQL Server.</p>
            </div>
            <a class="btn-gold btn-sm" asp-controller="Home" asp-action="Analyze">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="me-1">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                Analyze New Job
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="cyber-card text-center py-5">
                <div class="brand-icon mx-auto mb-3" style="width: 50px; height: 50px;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
                <h4 class="text-white fw-bold mb-2">No Analysis Records Found</h4>
                <p class="text-secondary-custom small mb-4" style="max-width: 500px; margin: 0 auto;">
                    No job postings have been analyzed and persisted to the SQL Server database yet. Submit a job advertisement to initiate screening.
                </p>
                <a class="btn-gold btn-sm" asp-controller="Home" asp-action="Analyze">Analyze a Job Now</a>
            </div>
        }
        else
        {
            <div class="cyber-card p-0 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle">
                        <thead class="bg-secondary-custom border-bottom border-dark-custom">
                            <tr>
                                <th class="text-gold py-3 ps-4" style="width: 15%;">Timestamp</th>
                                <th class="text-gold py-3" style="width: 25%;">Job Title</th>
                                <th class="text-gold py-3" style="width: 18%;">Company</th>
                                <th class="text-gold py-3 text-center" style="width: 16%;">AI Verdict</th>
                                <th class="text-gold py-3 text-center" style="width: 12%;">Risk Score</th>
                                <th class="text-gold py-3 text-end pe-4" style="width: 14%;">Action</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var item in Model)
                            {
                                var isFraud = string.Equals(item.Prediction, "Fraudulent", StringComparison.OrdinalIgnoreCase);
                                <tr class="border-bottom border-dark-custom">
                                    <td class="ps-4 small text-secondary-custom">
                                        @item.AnalysisDate.ToString("MMM dd, yyyy")<br />
                                        <span class="text-secondary-custom small">@item.AnalysisDate.ToString("HH:mm") UTC</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-white">@item.JobTitle</div>
                                        <div class="small text-secondary-custom">
                                            <span class="badge bg-secondary text-light me-1">@item.EmploymentType</span>
                                            @item.JobLocation
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-gold fw-semibold">@item.CompanyName</div>
                                        @if (!string.IsNullOrEmpty(item.CompanyWebsite) && (item.CompanyWebsite.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || item.CompanyWebsite.StartsWith("https://", StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <a href="@item.CompanyWebsite" target="_blank" rel="noopener noreferrer" class="small text-secondary-custom text-decoration-none text-truncate d-inline-block" style="max-width: 160px;">
                                                🔗 @item.CompanyWebsite
                                            </a>
                                        }
                                        else if (!string.IsNullOrEmpty(item.CompanyWebsite))
                                        {
                                            <span class="small text-secondary-custom text-truncate d-inline-block" style="max-width: 160px;">
                                                🌐 @item.CompanyWebsite
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (string.IsNullOrEmpty(item.Prediction))
                                        {
                                            <span class="badge bg-secondary text-light">Unclassified</span>
                                        }
                                        else if (isFraud)
                                        {
                                            <span class="badge bg-dark border border-danger text-danger px-2 py-1 small">
                                                ⚠️ Fraudulent
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark border border-success text-success px-2 py-1 small">
                                                ✓ Genuine
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.RiskScore.HasValue)
                                        {
                                            <span class="fw-bold @(isFraud ? "text-danger" : "text-success")">
                                                @item.RiskScore.Value%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary-custom">—</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a class="btn-dark-outline btn-sm py-1 px-2" asp-controller="Home" asp-action="Result" asp-route-id="@item.Id">
                                            View Report &rarr;
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

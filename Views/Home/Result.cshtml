@model _NET_PROJECT.ViewModels.PredictionResultViewModel
@{
    ViewData["Title"] = "Prediction Result Analysis";
    var isFraud = string.Equals(Model.Status, "Fraudulent", StringComparison.OrdinalIgnoreCase);
}

<div class="py-5 bg-main">
    <div class="container" style="max-width: 980px;">
        
        @if (Model.IsDemoPlaceholder)
        {
            <!-- Demonstration Disclaimer Banner (Shown only for design preview without an evaluation ID) -->
            <div class="demo-banner mb-4">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-gold flex-shrink-0">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div>
                    <strong class="text-white d-block mb-1">Visual Design Demonstration Mode</strong>
                    <span class="small text-secondary-custom">
                        You are viewing a demonstration preview. Real job advertisement submissions are processed by the live <strong>ML.NET FastTree</strong> model and saved to the SQL Server database.
                    </span>
                </div>
            </div>

            <!-- Result Status Controls / Toggle between Fraud and Genuine visual demonstration -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
                <div>
                    <span class="section-badge mb-1">Demo Assessment Preview</span>
                    <h2 class="h3 fw-bold text-white mb-0">Analysis & Threat Breakdown</h2>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary-custom small">Switch Visual Demo:</span>
                    <a class="btn @(isFraud ? "btn-dark-outline border-danger text-danger" : "btn-dark-outline") btn-sm" 
                       asp-controller="Home" asp-action="Result" asp-route-mode="fraud">
                        <span class="text-danger-custom">●</span> Sample Scam
                    </a>
                    <a class="btn @(!isFraud ? "btn-dark-outline border-success text-success" : "btn-dark-outline") btn-sm" 
                       asp-controller="Home" asp-action="Result" asp-route-mode="genuine">
                        <span class="text-success">●</span> Sample Genuine
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Live Model Evaluation Header -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
                <div>
                    <span class="section-badge mb-1">Live AI Evaluation Result</span>
                    <h2 class="h3 fw-bold text-white mb-0">Recruitment Threat Breakdown</h2>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-dark border border-dark-custom text-gold py-2 px-3 small">
                        <span class="text-success me-1">●</span> Model: @Model.ModelName
                    </span>
                    @if (Model.RecordId.HasValue)
                    {
                        <span class="badge bg-dark border border-dark-custom text-secondary-custom py-2 px-3 small">
                            Record #@Model.RecordId.Value
                        </span>
                    }
                </div>
            </div>
        }

        <!-- Primary Verdict Card -->
        <div class="cyber-card mb-4 border-2 @(isFraud ? "border-danger" : "border-success")">
            <div class="row g-4 align-items-center">
                <!-- Status & Score Column -->
                <div class="col-lg-4 text-center border-lg-end border-dark-custom pe-lg-4">
                    <div class="mb-3">
                        @if (isFraud)
                        {
                            <span class="status-badge-fraud">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="15" y1="9" x2="9" y2="15"></line>
                                    <line x1="9" y1="9" x2="15" y2="15"></line>
                                </svg>
                                HIGH RISK: FRAUDULENT
                            </span>
                        }
                        else
                        {
                            <span class="status-badge-genuine">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                </svg>
                                LOW RISK: GENUINE
                            </span>
                        }
                    </div>

                    <!-- Risk Gauge Circle -->
                    <div class="score-circle @(isFraud ? "score-fraud" : "score-genuine") mb-2">
                        <span class="score-value @(isFraud ? "text-danger" : "text-success")">@Model.RiskScore%</span>
                        <span class="score-label">Risk Index</span>
                    </div>

                    <div class="text-secondary-custom small mb-1">
                        Risk Level: <strong class="@(isFraud ? "text-danger" : "text-success")">@Model.RiskLevel</strong>
                    </div>
                    <div class="text-secondary-custom small">
                        Fraud Probability: <strong class="text-white">@Model.PredictionProbability.ToString("F1")%</strong>
                    </div>
                </div>

                <!-- Inspected Details & Summary Column -->
                <div class="col-lg-8 ps-lg-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <h4 class="text-white fw-bold mb-0">@Model.JobTitle</h4>
                        <span class="badge bg-secondary text-light">@Model.EmploymentType</span>
                    </div>
                    <div class="text-gold fw-semibold mb-3">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        </svg>
                        @Model.CompanyName &nbsp;•&nbsp; 
                        <span class="text-secondary-custom small">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                <circle cx="12" cy="10" r="3"></circle>
                                <path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 6.9 8 11.7z"></path>
                            </svg>
                            @Model.JobLocation
                        </span>
                    </div>

                    <h6 class="text-gold text-uppercase fw-bold small mb-2" style="letter-spacing: 0.05em;">AI Threat Assessment Summary</h6>
                    <p class="text-secondary-custom small mb-3">
                        @Model.AnalysisSummary
                    </p>

                    <div class="d-flex flex-wrap gap-2 text-secondary-custom small">
                        <span class="badge bg-dark border border-dark-custom">
                            Evaluation Date: @Model.AnalyzedAt.ToString("MMM dd, yyyy HH:mm UTC")
                        </span>
                        <span class="badge bg-dark border border-dark-custom">
                            Detection Engine: ML.NET FastTree (GBDT)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Warning Indicators & Safety Recommendations Grid -->
        <div class="row g-4 mb-4">
            <!-- Warning Indicators -->
            <div class="col-md-6">
                <div class="cyber-card h-100">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2 @(isFraud ? "text-danger" : "text-success")">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            @if (isFraud)
                            {
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            }
                            else
                            {
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            }
                        </svg>
                        @(isFraud ? "Key Threat Indicators" : "Verified Safe Signals")
                    </h5>

                    <div class="warning-list">
                        @foreach (var indicator in Model.WarningIndicators)
                        {
                            <div class="@(isFraud ? "warning-item" : "safe-item")">
                                <span class="fw-bold">@(isFraud ? "⚠️" : "✓")</span>
                                <div>@indicator</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Safety Recommendations -->
            <div class="col-md-6">
                <div class="cyber-card h-100">
                    <h5 class="text-gold fw-bold mb-3 d-flex align-items-center gap-2">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            <path d="m9 12 2 2 4-4"></path>
                        </svg>
                        Candidate Safety Recommendations
                    </h5>

                    <div class="recommendations-list">
                        @foreach (var recommendation in Model.SafetyRecommendations)
                        {
                            <div class="recommendation-item">
                                <span class="text-gold fw-bold">🛡️</span>
                                <div>@recommendation</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Controls -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-3 border-top border-dark-custom">
            <div class="d-flex gap-2">
                <a class="btn-dark-outline" asp-controller="Home" asp-action="Index">
                    &larr; Platform Home
                </a>
                <a class="btn-dark-outline" asp-controller="Home" asp-action="History">
                    View History
                </a>
            </div>
            <div class="d-flex gap-2">
                <a class="btn-gold" asp-controller="Home" asp-action="Analyze">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    Analyze Another Posting
                </a>
            </div>
        </div>
    </div>
</div>

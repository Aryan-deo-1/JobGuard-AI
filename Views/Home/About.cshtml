@{
    ViewData["Title"] = "About Recruitment Fraud & AI Threat Intelligence";
}

<div class="py-5 bg-main">
    <div class="container" style="max-width: 960px;">
        <!-- Header -->
        <div class="text-center mb-5">
            <span class="section-badge">Threat Intelligence & Education</span>
            <h1 class="h2 fw-bold text-white mb-3">Understanding Recruitment Fraud & AI Defense</h1>
            <p class="text-secondary-custom mx-auto" style="max-width: 680px;">
                Recruitment cybercrime represents one of the fastest growing vectors of identity theft and financial fraud worldwide. Here is how modern threat actors operate and how AI neutralizes them.
            </p>
        </div>

        <!-- Section 1: What is Recruitment Fraud -->
        <div class="cyber-card mb-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                </div>
                <h4 class="fw-bold text-white mb-0">What is Recruitment Fraud?</h4>
            </div>
            <p class="text-secondary-custom mb-3">
                Recruitment fraud is an intentional, sophisticated cyber confidence scheme where malicious actors pose as legitimate hiring managers, corporate recruiters, or placement agencies to deceive job seekers. By circulating fabricated job vacancies across digital job portals, social networks, and email campaigns, scammers exploit the urgency, optimism, and trust of employment seekers.
            </p>
            <p class="text-secondary-custom mb-0">
                These fraudulent campaigns frequently hijack legitimate corporate identities, mimic authentic career websites, and forge official offer letters to simulate realistic corporate recruitment processes.
            </p>
        </div>

        <!-- Section 2: Why Fake Job Advertisements Are Dangerous -->
        <div class="cyber-card mb-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                </div>
                <h4 class="fw-bold text-white mb-0">Why Fake Job Advertisements Are Dangerous</h4>
            </div>
            <p class="text-secondary-custom mb-3">
                Unlike simple spam, employment fraud causes severe and lasting real-world harm to victims through four primary attack vectors:
            </p>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 bg-secondary-custom border border-dark-custom rounded h-100">
                        <h6 class="text-gold fw-bold mb-1">1. Financial Extortion & Advance-Fee Fraud</h6>
                        <p class="text-secondary-custom small mb-0">
                            Scammers issue fake cashier checks for "home office setup" and instruct victims to wire excess funds back to fraudulent suppliers before the check bounces, leaving the victim liable.
                        </p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-secondary-custom border border-dark-custom rounded h-100">
                        <h6 class="text-gold fw-bold mb-1">2. Identity Theft & Credential Harvesting</h6>
                        <p class="text-secondary-custom small mb-0">
                            Under the guise of pre-employment background checks or direct-deposit setups, scammers extract social security numbers, banking details, passport scans, and birth certificates.
                        </p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-secondary-custom border border-dark-custom rounded h-100">
                        <h6 class="text-gold fw-bold mb-1">3. Re-Shipping & Money Mule Exploitation</h6>
                        <p class="text-secondary-custom small mb-0">
                            Unsuspecting victims are hired as "Package Quality Inspectors" or "Payment Processing Agents," unknowingly receiving stolen merchandise and laundering money for criminal rings.
                        </p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-secondary-custom border border-dark-custom rounded h-100">
                        <h6 class="text-gold fw-bold mb-1">4. Malware & Remote Access Infiltration</h6>
                        <p class="text-secondary-custom small mb-0">
                            Victims are instructed to download specialized "interview screening applications" or "time-tracking utilities" that contain remote access trojans (RATs) and keyloggers.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 3: How AI Detects Suspicious Advertisements -->
        <div class="cyber-card mb-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                    </svg>
                </div>
                <h4 class="fw-bold text-white mb-0">How AI Detects Suspicious Job Postings</h4>
            </div>
            <p class="text-secondary-custom mb-3">
                Human intuition often struggles to distinguish legitimate startup opportunities from sophisticated cyber scams. AI models bring computational scale and objective pattern recognition:
            </p>
            <ul class="text-secondary-custom mb-0 ps-3">
                <li class="mb-2">
                    <strong class="text-white">Natural Language Processing (NLP):</strong> Tokenizes and evaluates stylistic features, artificial urgency markers, lexical repetitiveness, and grammatical dissonance common in scam scripts.
                </li>
                <li class="mb-2">
                    <strong class="text-white">Entity & Domain Consistency Verification:</strong> Cross-checks employer domain syntax, detecting deceptive subdomains, missing corporate registrations, or disposable email hosts.
                </li>
                <li class="mb-2">
                    <strong class="text-white">Compensation Anomaly Modeling:</strong> Analyzes compensation offers against regional and industry baseline distributions to identify statistically implausible salaries designed to bypass applicant skepticism.
                </li>
                <li>
                    <strong class="text-white">Multimodal Risk Fusion:</strong> Synthesizes multiple weak indicators into a unified, probabilistic risk score that highlights actionable concerns rather than binary assertions.
                </li>
            </ul>
        </div>

        <!-- Section 4: Platform Features Matrix -->
        <div class="cyber-card mb-5">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                </div>
                <h4 class="fw-bold text-white mb-0">JobGuard AI Core Architecture Features</h4>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-bordered border-dark-custom mb-0">
                    <thead>
                        <tr>
                            <th class="text-gold" style="width: 30%;">Capability</th>
                            <th class="text-gold">Technical Implementation</th>
                            <th class="text-gold" style="width: 20%;">Security Value</th>
                        </tr>
                    </thead>
                    <tbody class="text-secondary-custom small">
                        <tr>
                            <td class="text-white fw-bold">Domain & Email Authentication</td>
                            <td>Heuristic registrar and disposable mailbox pattern matcher</td>
                            <td>Stops impersonation</td>
                        </tr>
                        <tr>
                            <td class="text-white fw-bold">Advance-Fee Pattern Parser</td>
                            <td>Semantic detector for wire, crypto, check, and equipment clauses</td>
                            <td>Prevents monetary loss</td>
                        </tr>
                        <tr>
                            <td class="text-white fw-bold">Probabilistic Threat Scoring</td>
                            <td>Multi-attribute risk weighting engine calibrated for fraud datasets</td>
                            <td>Clear verdict</td>
                        </tr>
                        <tr>
                            <td class="text-white fw-bold">Zero-Knowledge Querying</td>
                            <td>Stateless request evaluation without retaining candidate personal data</td>
                            <td>Protects privacy</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Action Callout -->
        <div class="text-center p-4 bg-secondary-custom border border-dark-custom rounded-3">
            <h4 class="fw-bold text-white mb-2">Test Any Questionable Job Posting</h4>
            <p class="text-secondary-custom mb-3 small">Use our free analysis form to screen any listing before applying or sharing personal information.</p>
            <a class="btn-gold" asp-controller="Home" asp-action="Analyze">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                Analyze a Job Now
            </a>
        </div>
    </div>
</div>


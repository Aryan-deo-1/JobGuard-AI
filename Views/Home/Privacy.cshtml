@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="py-5 bg-main">
    <div class="container" style="max-width: 860px;">
        <div class="mb-4 text-center">
            <span class="section-badge">Data Protection</span>
            <h1 class="h2 fw-bold text-white mb-2">Privacy & Security Commitment</h1>
            <p class="text-secondary-custom">How JobGuard AI safeguards candidate data and operational queries.</p>
        </div>

        <div class="cyber-card mb-4">
            <h5 class="text-gold fw-bold mb-3">1. Zero-Knowledge Job Screening</h5>
            <p class="text-secondary-custom small mb-3">
                JobGuard AI is engineered to evaluate public job advertisement text, company domain syntax, and communication indicators without requiring users to submit personal resumes, telephone numbers, home addresses, or government identification.
            </p>

            <h5 class="text-gold fw-bold mb-3">2. In-Memory Analysis Lifecycle</h5>
            <p class="text-secondary-custom small mb-3">
                Job descriptions submitted through the analyzer interface are processed in volatile memory for threat scoring and are not stored in permanent public databases or sold to recruitment brokers.
            </p>

            <h5 class="text-gold fw-bold mb-3">3. No Third-Party Tracking</h5>
            <p class="text-secondary-custom small mb-0">
                Our platform does not deploy invasive tracking pixels or cross-site advertising cookies. All styling and assets are bundled locally within the ASP.NET Core application.
            </p>
        </div>

        <div class="text-center">
            <a class="btn-dark-outline btn-sm" asp-controller="Home" asp-action="Index">&larr; Return to Home</a>
        </div>
    </div>
</div>

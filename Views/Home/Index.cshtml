@{
    ViewData["Title"] = "AI-Based Fake Job & Recruitment Fraud Detection";
}

<!-- Hero Section -->
<section class="hero-section text-center">
    <div class="container">
        <div class="hero-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-gold">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>Next-Gen Recruitment Fraud Defense Platform</span>
        </div>

        <h1 class="hero-title">
            Find Genuine Jobs.<br />
            <span class="text-gold">Avoid Recruitment Scams.</span>
        </h1>

        <p class="hero-subtitle">
            JobGuard AI inspects job advertisements, recruiter profiles, and communication patterns using advanced machine intelligence to safeguard career seekers against identity theft, fake employment, and advance-fee schemes.
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-3 mb-5">
            <a class="btn-gold" asp-controller="Home" asp-action="Analyze">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                Analyze Job Posting
            </a>
            <a class="btn-dark-outline" href="#features">
                Explore Protection Features
            </a>
        </div>

        <!-- Quick Platform Metrics -->
        <div class="row g-3 justify-content-center" style="max-width: 900px; margin: 0 auto;">
            <div class="col-6 col-md-3">
                <div class="metric-box">
                    <div class="metric-number">98.4%</div>
                    <div class="metric-label">Pattern Accuracy</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-box">
                    <div class="metric-number">6+</div>
                    <div class="metric-label">Threat Vectors</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-box">
                    <div class="metric-number">&lt; 1s</div>
                    <div class="metric-label">Inspection Speed</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-box">
                    <div class="metric-number">100%</div>
                    <div class="metric-label">Privacy-First</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="py-5 bg-main">
    <div class="container py-4">
        <div class="text-center">
            <span class="section-badge">Platform Capabilities</span>
            <h2 class="section-title">Engineered to Neutralize Recruitment Fraud</h2>
            <p class="section-subtitle">
                Comprehensive multi-vector screening designed to isolate phishing attempts, advance-fee traps, and counterfeit employer profiles.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="cyber-card h-100">
                    <div class="feature-icon-wrapper">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="4 7 4 4 20 4 20 7"></polyline>
                            <line x1="9" y1="20" x2="15" y2="20"></line>
                            <line x1="12" y1="4" x2="12" y2="20"></line>
                        </svg>
                    </div>
                    <h5 class="fw-bold mb-2 text-white">Linguistic & Semantic Anomaly Check</h5>
                    <p class="text-secondary-custom small mb-0">
                        Evaluates job descriptions for high-urgency language, poor grammatical consistency, vague job duties, and manipulative psychological triggers.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="cyber-card h-100">
                    <div class="feature-icon-wrapper">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                    </div>
                    <h5 class="fw-bold mb-2 text-white">Domain & Employer Verification</h5>
                    <p class="text-secondary-custom small mb-0">
                        Flags recruiters communicating via public free mailboxes (e.g., generic Gmail/Yahoo) or recently registered lookalike corporate domains.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="cyber-card h-100">
                    <div class="feature-icon-wrapper">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                    <h5 class="fw-bold mb-2 text-white">Compensation Anomaly Detection</h5>
                    <p class="text-secondary-custom small mb-0">
                        Identifies unrealistic salary-to-experience ratios designed as clickbait to harvest personal credentials or banking information.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="cyber-card h-100">
                    <div class="feature-icon-wrapper">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </div>
                    <h5 class="fw-bold mb-2 text-white">Advance-Fee & Phishing Defense</h5>
                    <p class="text-secondary-custom small mb-0">
                        Detects hidden requests for equipment deposits, software license fees, background check charges, or pre-employment wire transfers.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="cyber-card h-100">
                    <div class="feature-icon-wrapper">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                        </svg>
                    </div>
                    <h5 class="fw-bold mb-2 text-white">Real-Time Risk Scoring Engine</h5>
                    <p class="text-secondary-custom small mb-0">
                        Generates a clear 0-100% composite risk score backed by transparent model confidence metrics and flagged threat indicators.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="cyber-card h-100">
                    <div class="feature-icon-wrapper">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </div>
                    <h5 class="fw-bold mb-2 text-white">Actionable Safety Guidance</h5>
                    <p class="text-secondary-custom small mb-0">
                        Supplies candidate defense advisories, safe communication protocols, and step-by-step reporting instructions if fraud is detected.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section id="how-it-works" class="py-5 bg-secondary-custom border-top border-bottom border-dark-custom">
    <div class="container py-4">
        <div class="text-center">
            <span class="section-badge">Streamlined Workflow</span>
            <h2 class="section-title">How JobGuard AI Works</h2>
            <p class="section-subtitle">
                A three-step verification pipeline that delivers instant threat assessment without requiring account registration.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="cyber-card h-100 text-center text-md-start">
                    <div class="step-number mx-auto mx-md-0">1</div>
                    <h5 class="fw-bold text-white mb-2">Input Job Details</h5>
                    <p class="text-secondary-custom small mb-0">
                        Enter the job title, company name, employment type, location, and the full job description into the analysis interface.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="cyber-card h-100 text-center text-md-start">
                    <div class="step-number mx-auto mx-md-0">2</div>
                    <h5 class="fw-bold text-white mb-2">Deep Pattern Inspection</h5>
                    <p class="text-secondary-custom small mb-0">
                        The platform extracts linguistic markers, structural anomalies, company profile consistency, and known scam signatures.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="cyber-card h-100 text-center text-md-start">
                    <div class="step-number mx-auto mx-md-0">3</div>
                    <h5 class="fw-bold text-white mb-2">Verdict & Safety Advisory</h5>
                    <p class="text-secondary-custom small mb-0">
                        Receive a visual fraud probability rating, an itemized breakdown of detected warnings, and specific defensive recommendations.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>


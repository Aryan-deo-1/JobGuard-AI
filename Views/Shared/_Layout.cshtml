<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JOBGUARD AI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_NET_PROJECT.styles.css" asp-append-version="true" />
</head>
<body class="bg-main text-light">
    <!-- Main Header & Navigation -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-jobguard">
            <div class="container">
                <a class="navbar-brand-jobguard" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            <path d="m9 12 2 2 4-4"></path>
                        </svg>
                    </span>
                    <span>JOBGUARD <span class="text-gold">AI</span></span>
                </a>

                <button class="navbar-toggler border-dark-custom" type="button" data-bs-toggle="collapse" data-bs-target="#navbarJobGuard" 
                        aria-controls="navbarJobGuard" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarJobGuard">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Analyze">Analyze Job</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="History">History</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="/Home#features">Features</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item ms-lg-2">
                                <span class="nav-link text-gold small px-2 d-flex align-items-center gap-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-dark-outline btn-sm py-1 px-3">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link nav-link-custom" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-dark-outline btn-sm py-1 px-3" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <a class="btn-gold btn-sm" asp-controller="Home" asp-action="Analyze">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                                Analyze Job
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Page Body -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Global Footer -->
    <footer class="footer-jobguard">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                        </span>
                        <span class="fs-5 fw-bold text-white">JOBGUARD <span class="text-gold">AI</span></span>
                    </div>
                    <p class="text-secondary-custom mb-3" style="max-width: 420px;">
                        Enterprise-grade AI intelligence system engineered to identify fraudulent job advertisements, combat recruitment phishing, and protect career seekers worldwide.
                    </p>
                    <div class="d-flex align-items-center gap-2 text-secondary-custom small">
                        <span class="badge bg-dark border border-secondary text-gold">ASP.NET Core .NET 8</span>
                        <span class="badge bg-dark border border-secondary text-secondary-custom">Cybersecurity Architecture</span>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-gold fw-bold mb-3 text-uppercase" style="letter-spacing: 0.05em; font-size: 0.85rem;">Platform Links</h6>
                    <ul class="list-unstyled mb-0">
                        <li><a class="footer-link" asp-controller="Home" asp-action="Index">Platform Home</a></li>
                        <li><a class="footer-link" asp-controller="Home" asp-action="Analyze">Job Analyzer Form</a></li>
                        <li><a class="footer-link" asp-controller="Home" asp-action="History">Analysis History</a></li>
                        <li><a class="footer-link" href="/Home#features">Fraud Detection Features</a></li>
                        <li><a class="footer-link" href="/Home#how-it-works">How It Works</a></li>
                        <li><a class="footer-link" asp-controller="Home" asp-action="About">About Threat Intelligence</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h6 class="text-gold fw-bold mb-3 text-uppercase" style="letter-spacing: 0.05em; font-size: 0.85rem;">Recruitment Safety Notice</h6>
                    <p class="text-secondary-custom small mb-3">
                        Legitimate employers will never demand payment for interview equipment, training materials, or software licenses before official employment confirmation. Always verify company communications against authentic corporate domains.
                    </p>
                    <a class="btn-dark-outline btn-sm" asp-controller="Home" asp-action="About">
                        Learn Common Fraud Indicators &rarr;
                    </a>
                </div>
            </div>

            <hr class="footer-divider" />

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-secondary-custom">
                <div>
                    &copy; @DateTime.UtcNow.Year JobGuard AI Platform. All rights reserved.
                </div>
                <div class="d-flex gap-3">
                    <a class="footer-link small" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a class="footer-link small" asp-controller="Home" asp-action="About">Security Guidelines</a>
                    <a class="footer-link small" href="#">Terms of Use</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
